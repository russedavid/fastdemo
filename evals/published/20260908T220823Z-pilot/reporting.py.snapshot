"""Candidate report component: structured generation and explicit evidence states.

Structural validation and citation-ID checks are not semantic fact checking.
The component has no model credentials, reference answers, or network calls.
"""

import json
from datetime import date
from pathlib import Path
from typing import Literal

from pydantic import BaseModel, ConfigDict, Field, PositiveInt, model_validator

HERE = Path(__file__).resolve().parent


class StrictModel(BaseModel):
    model_config = ConfigDict(extra="forbid", strict=True)


class Claim(StrictModel):
    text: str = Field(min_length=1)
    source_ids: list[str] = Field(min_length=1)


class EvidenceValue(StrictModel):
    state: Literal["known", "unknown", "conflicting"]
    value: str | None
    source_ids: list[str] = Field(min_length=1)

    @model_validator(mode="after")
    def value_matches_state(self):
        if self.state == "known" and (self.value is None or not self.value.strip()):
            raise ValueError("A known field requires a nonempty supported value")
        if self.state != "known" and self.value is not None:
            raise ValueError("Unknown or conflicting fields must have a null value")
        return self


class Priority(EvidenceValue):
    value: Literal["low", "medium", "high", "critical"] | None


class ServiceDate(EvidenceValue):
    @model_validator(mode="after")
    def valid_date(self):
        if self.value is not None:
            parsed = date.fromisoformat(self.value)
            if parsed.isoformat() != self.value:
                raise ValueError("Use a complete ISO calendar date: YYYY-MM-DD")
        return self


class Part(StrictModel):
    part_number: str = Field(min_length=1)
    quantity: PositiveInt | None
    source_ids: list[str] = Field(min_length=1)


class PartsUsed(StrictModel):
    state: Literal["known", "none", "unknown", "conflicting"]
    items: list[Part]
    source_ids: list[str] = Field(min_length=1)

    @model_validator(mode="after")
    def items_match_state(self):
        if self.state == "known" and not self.items:
            raise ValueError("Known parts use requires at least one recorded part")
        if self.state != "known" and self.items:
            raise ValueError(
                "None, unknown, or conflicting parts use must not assert installed parts"
            )
        return self


class ProposedAction(Claim):
    basis: Literal["source", "clarification"]


class Uncertainty(Claim):
    field: Literal[
        "equipment_id", "parts_used", "priority", "next_service_date", "other"
    ]


class Report(StrictModel):
    equipment_id: EvidenceValue = Field(
        description="Exact equipment identifier copied verbatim. Put revision, location, and explanatory text in observations, not in this value."
    )
    observations: list[Claim] = Field(min_length=1)
    completed_work: list[Claim]
    parts_used: PartsUsed
    proposed_actions: list[ProposedAction]
    uncertainties: list[Uncertainty]
    priority: Priority
    next_service_date: ServiceDate

    @model_validator(mode="after")
    def conflicts_are_visible(self):
        explained = {item.field for item in self.uncertainties}
        for field in ("equipment_id", "parts_used", "priority", "next_service_date"):
            if getattr(self, field).state == "conflicting" and field not in explained:
                raise ValueError(
                    f"A conflicting {field} requires an attributed uncertainty entry"
                )
        return self


def source_ids_from_items(items):
    ids = []
    for item in items:
        header, separator, text = item["transcription"].partition("\n")
        if not separator or not text.strip():
            raise ValueError("Every source needs a metadata header and nonempty text")
        source_id = json.loads(header).get("id")
        if not isinstance(source_id, str) or not source_id.strip() or source_id in ids:
            raise ValueError("Source IDs must be nonempty and unique within the packet")
        ids.append(source_id)
    if not ids:
        raise ValueError("A source packet is required")
    return ids


def source_texts_from_items(items):
    ids = source_ids_from_items(items)
    return {
        source_id: item["transcription"].partition("\n")[2]
        for source_id, item in zip(ids, items)
    }


def response_schema(source_ids):
    schema = Report.model_json_schema()

    def restrict_ids(node):
        if isinstance(node, dict):
            references = node.get("properties", {}).get("source_ids")
            if references is not None:
                references["items"]["enum"] = list(source_ids)
            for value in node.values():
                restrict_ids(value)
        elif isinstance(node, list):
            for value in node:
                restrict_ids(value)

    restrict_ids(schema)
    return schema


def build_request(items, model):
    ids = source_ids_from_items(items)
    schema = response_schema(ids)
    packet = "\n\n".join(item["transcription"] for item in items)
    return {
        "model": model,
        "temperature": 0.3,
        "messages": [
            {
                "role": "system",
                "content": (HERE / "report-instructions.txt").read_text(),
            },
            {
                "role": "user",
                "content": "SOURCE PACKET\n"
                + packet
                + "\n\nRESPONSE JSON SCHEMA\n"
                + json.dumps(schema, separators=(",", ":")),
            },
        ],
        "response_format": {
            "type": "json_schema",
            "json_schema": {
                "name": "frontline_report",
                "strict": True,
                "schema": schema,
            },
        },
    }


def parse_report(content, source_texts):
    if not isinstance(source_texts, dict):
        raise TypeError(
            "Citation validation requires source IDs mapped to their original text"
        )
    report = Report.model_validate_json(content)
    data = report.model_dump(mode="json")
    allowed = set(source_texts)

    def check_ids(node):
        if isinstance(node, dict):
            if "source_ids" in node:
                ids = node["source_ids"]
                if len(ids) != len(set(ids)) or not set(ids) <= allowed:
                    raise ValueError(
                        "Citation IDs must be unique and belong to the supplied source packet"
                    )
            for value in node.values():
                check_ids(value)
        elif isinstance(node, list):
            for value in node:
                check_ids(value)
        elif isinstance(node, str):
            if any((ord(character) < 32 and character not in "\n\t") or ord(character) == 127 for character in node):
                raise ValueError("Report text contains an unexpected control character")

    check_ids(data)
    identifiers = []
    if report.equipment_id.state == "known":
        identifiers.append(
            ("equipment_id", report.equipment_id.value, report.equipment_id.source_ids)
        )
    identifiers += [
        ("part_number", part.part_number, part.source_ids)
        for part in report.parts_used.items
    ]
    for field, value, ids in identifiers:
        if not any(value in source_texts[source_id] for source_id in ids):
            raise ValueError(
                f"{field} must occur verbatim in a cited source; do not append descriptions or normalize the identifier"
            )
    return data
